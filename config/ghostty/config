macos-option-as-alt = left
# theme = zenwritten_light
# theme = GitHub-Light-Default
# theme = Alabaster
# Alabaster's hues are too vivid against a light background; the palette below
# keeps the muted set but puts every slot on a deliberate contrast tier vs the
# #dadada background: 8 (dim) 2.4:1, 1-7 3.8:1, 9-15 5.6:1, 0 7.9:1.
# Regenerate (after changing the background, or to dial the tiers):
#   bun run ghostty-palette --help
background = #dadada
foreground = #4e4e4e
cursor-color = #4a6f92
cursor-text = #dadada
selection-background = #afd7d7
selection-foreground = #3c3c3c
palette = 0=#3c3c3c
palette = 1=#a55252
palette = 2=#517351
palette = 3=#866444
palette = 4=#4a6f92
palette = 5=#855e85
palette = 6=#507272
palette = 7=#6b6b6b
palette = 8=#8d8d8d
palette = 9=#843b3b
palette = 10=#3b5a3b
palette = 11=#694c2f
palette = 12=#345474
palette = 13=#6a466a
palette = 14=#3a5757
palette = 15=#525252

keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
# font-family = "Maple Mono NL NF CN"
font-family = "Iosevka Fixed"
# https://github.com/be5invis/Iosevka/blob/v33.3.1/doc/PACKAGE-LIST.md
#  download first font `Iosevka Fixed` Super TTC: 

keybind = super+r=reload_config
cursor-style-blink = false
# background-opacity = 0.9
